    local content = create("Frame", {
        Name = "ButtonContent",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(0, 18),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        ZIndex = 5,
    }, button)
    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, iconName and 8 or 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, content)
    if iconName then
        local icon = lucideIcon(content, iconName, UDim2.new(), UDim2.fromOffset(16, 16), COLORS.text, 5)
        icon.LayoutOrder = 1
        icon.ImageTransparency = 0.08
    end
    local label = textLabel(content, text, UDim2.new(), UDim2.fromOffset(0, 18),
        Enum.Font.GothamBold, 13, COLORS.text, Enum.TextXAlignment.Center)
